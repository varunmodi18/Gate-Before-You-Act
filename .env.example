# Non-secret overrides for config/app.yaml. Export them in the shell before `make up`
# (the app reads GBYA_* from the environment; .env files are gitignored and not auto-loaded).
# GBYA_ENV=dev
# GBYA_API_PORT=8000
# GBYA_MODEL_BASE_URL=http://127.0.0.1:8001/v1
# Optional, read from the environment only and never committed:
# HF_TOKEN=
